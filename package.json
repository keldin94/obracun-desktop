{
  "name": "keldin-obracun-desktop-runtime",
  "version": "0.3.8",
  "private": true,
  "description": "Offline browser UI runtime used by the Windows and macOS desktop executables",
  "scripts": {
    "build:runtime": "esbuild app/runtime-entry.js --bundle --minify --format=iife --platform=browser --target=chrome110 --outfile=app/runtime.bundle.js",
    "test:ui": "node scripts/smoke-ui.cjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "playwright": "1.54.2"
  }
}
